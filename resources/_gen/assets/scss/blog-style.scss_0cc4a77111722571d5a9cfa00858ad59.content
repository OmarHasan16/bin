.heading h6,.project-text a,.latest-blog-post h4:hover,.title-blog a,.title-blog>span,.brandicon li a i:hover,.portfolio-img h3 a:hover,.standard span,.Pricing-style i,.splash-area.blog a,.portfolio-controllers button.is-checked,.next-previous a:hover,.successful h3,.sercive-style-text a,.strategic-sercives h4:hover,.team-member-text h6:hover,.join-our-team h5,.portfolio-img>a,.portfolios-data>a,.search-cross-btn i,.view-map-data a,.discovery-text.two h4:hover,.blog-posts-text a h4:hover,.makes-us-different-text a,.case-studies-project a,.client-review span,.mobile-nav>ul li>a:hover,.header.two .menu a:hover{color:#0049ff}.latest-news form button,.sercive-style-text .boder,.choose-us-img figure:before,.client-review i,.view-map-data i,.case-studies-two figure:before,#button,.preloader,.case-studies .style-shapes-3,.mobile-nav>ul>li.menu-item-has-children.active>ul.sub-menu li:before{background-color:#0049ff}.gap{padding:80px 0}.sidebar-wrapper{padding-left:30px}@media(max-width:991px){.sidebar-wrapper{padding-left:0;margin-top:60px}}.widget{margin-bottom:50px}.widget-title{font-size:20px;font-weight:700;margin-bottom:25px;padding-bottom:10px;border-bottom:1px solid #eee;position:relative;color:#222}.widget-title::after{content:"";position:absolute;left:0;bottom:-1px;width:50px;height:2px;background-color:#0049ff}.search-form{position:relative}.search-form input{width:100%;height:55px;border:1px solid #eee;padding:0 20px;border-radius:5px;outline:none}.search-form button{position:absolute;right:5px;top:5px;height:45px;width:45px;border:none;background:#0049ff;color:#fff;border-radius:4px}.post-featured-image{margin-bottom:30px;border-radius:10px;overflow:hidden}.post-featured-image img{width:100%;height:auto}.entry-content{margin-bottom:40px}.post-navigation{display:flex;justify-content:space-between;margin-top:40px;padding-top:30px;border-top:1px solid #eee}.post-navigation a{font-weight:600;color:#222}.post-navigation a:hover{color:#0049ff}